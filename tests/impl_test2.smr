struct Point {
    x: i64,
    y: i64,
}

impl Point {
    fn new(x: i64, y: i64) -> i64 {
        return x + y;
    }

    fn add(a: i64, b: i64) -> i64 {
        return a + b;
    }
}

fn main() -> i64 {
    let result: i64 = Point::new(10, 20);
    let sum: i64 = Point::add(result, 5);
    return sum;
}
